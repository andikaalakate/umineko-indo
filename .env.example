# ==============================================================
# Supabase Configuration for Umineko Indonesia Website
# Salin file ini menjadi .env lalu isi nilainya dari dashboard Supabase:
#   cp .env.example .env
# ==============================================================

# URL Project Supabase (contoh: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=

# Public Anon API Key Supabase (Project Settings -> API -> anon public key)
VITE_SUPABASE_ANON_KEY=
